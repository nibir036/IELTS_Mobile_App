# PostgreSQL connection for Prisma.
# Replace YOUR_PASSWORD with the password of the "postgres" user you set when
# installing PostgreSQL 18. If the password has special characters, encode them:
#   @ -> %40   # -> %23   : -> %3A   / -> %2F   % -> %25
# PostgreSQL 18 normally listens on 5432 (5433 if another version was installed first).
# The database "ielts_ai" is created automatically by the first migration.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ielts_ai?schema=public"

# Set to 0 to skip the demo account when seeding.
SEED_DEMO=1

# ── API server ──────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=60

# ── OTP by SMS (Alpha SMS BD, api.sms.net.bd) ───────────────────────────────
# "console" prints the code in the server window (and returns it to the app
# as devCode while NODE_ENV is not production). Use "alpha" to send real SMS.
SMS_PROVIDER=console
ALPHA_SMS_API_KEY=
SMS_BRAND=IELTS AI by nextED

# ── Writing grading: Gemini, the same as the website ─────────────────────────
# Get a key at https://aistudio.google.com/apikey . WRITING_PROVIDER can be
# "gemini" or "openrouter"; empty = Gemini when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_WRITING_MODEL=gemini-3.6-flash
# Study plan AI (weekly notes and "why" lines, uses GEMINI_API_KEY):
# all = every student, pro = paid only, off = rules only.
PLAN_AI=all
# Optional: a different Gemini model for the plan (empty = GEMINI_WRITING_MODEL).
GEMINI_PLAN_MODEL=
# Study hours needed per half band with all four modules (planning setting).
# PLAN_HOURS_PER_HALF_BAND=50
WRITING_PROVIDER=

# ── OpenRouter (speaking-partner chat; writing grading if no Gemini key) ────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# "openrouter/free" picks any free model. You can pin one, e.g.
# deepseek/deepseek-chat-v3.1:free — then list backups below (comma separated).
OPENROUTER_WRITING_MODEL=openrouter/free
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_MODEL_FALLBACKS=openrouter/free
OPENROUTER_REASONING_EFFORT=low
APP_URL=https://ieltsai.nexted.app

# ── Speaking evaluation service (NextED_IELTS_Speaking) ────────────────────
SPEAKING_API_BASE_URL=http://localhost:8000
# Must equal INTERNAL_API_KEY in the speaking service's .env
SPEAKING_API_KEY=

# ── Cloudflare R2 (recordings, photos, voice messages). Optional locally. ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Top folder in the bucket for everything the phone app stores (see src/lib/r2.ts).
R2_APP_PREFIX=ielts_app_phone_version

# ── Free plan limits (AI-graded tests before upgrading) ─────────────────────
FREE_WRITING_TESTS=4
FREE_SPEAKING_TESTS=4
MAX_BODY_MB=40
