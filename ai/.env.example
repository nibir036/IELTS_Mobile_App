# Copy to .env and fill in. Never commit .env.
# The service runs with NONE of these set - it uses a stub model and does
# no web research.

APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- caller
# YOU GENERATE THIS - it is not from any provider. It is a shared password
# between your Node API and this service, so nothing else can call it.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Put the same value in your Node .env and send it as:
#   Authorization: Bearer <SERVICE_TOKEN>
# Leave blank in development. REQUIRED in production - the service refuses
# to start unprotected.
SERVICE_TOKEN=

# ------------------------------------------------------------------- model
#   echo    no key, no network. Everything works except the writing.
#   demo    scripted replies, for trying the API. Knows only examples/pages.
#   groq    needs GROQ_API_KEY + GROQ_MODEL      -> console.groq.com
#   gemini  needs GEMINI_API_KEY + GEMINI_WRITING_MODEL
#                                                -> aistudio.google.com/apikey
#
# You are already on Gemini, so staying there means one less thing changing
# at once. Groq is usually cheaper and faster for open models. Either works
# - it is one line to switch.
LLM_PROVIDER=echo

GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_WRITING_MODEL=

# THE BIGGEST COST LEVER IN THIS FILE.
#
# Three of the four model calls per request are small jobs: understanding
# the request, planning searches, and reading a page. Those go to this
# model. Only the final ranking or phrasing uses the model above.
#
# Set it to the cheapest small model your provider offers - on Gemini a
# Flash-class model, on Groq one of the small Llama models. Check the
# provider's current model list for exact names; they change.
#
# Leave blank to use the main model for everything, which costs several
# times more for no real gain.
FAST_MODEL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------- research
# Where the finders get information they do not already hold.
#
#   tavily  tavily.com         - built for this, 1000 free searches/month
#   brave   brave.com/search/api - cheap, 2000 free/month
#   serper  serper.dev         - cheapest, 2500 free one-off credits
#
# Any of them is fine; the interface is identical. Start on a free tier -
# with the write-back, one search serves every student who asks next.
#
# Leave blank and the finders still work, answering from what is stored.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
RESEARCH_ENABLED=true

# Which sites may be fetched. Suffix matched on the registered domain, so
# "ac.uk" covers bristol.ac.uk but NOT evil-ac.uk.attacker.com.
# Starting with the UK keeps this list tight, which is a real security win.
ALLOWED_DOMAINS=ac.uk,chevening.org,britishcouncil.org,gov.uk

# What one request may spend going out to the web.
# Each page fetched is one model call to read it, so MAX_FETCHES is the
# second biggest cost lever here. 3-4 is usually plenty.
MAX_SEARCHES=2
MAX_FETCHES=4
#
# The time cap is the one that bites, and it bites silently: a page is a
# network fetch PLUS an extraction call, so one page costs 8-12 seconds.
# At 20 the first page was all that ever got read and every other result
# was dropped unread. Budget roughly 12 seconds per page you want read.
MAX_RESEARCH_SECONDS=60
FETCH_TIMEOUT_SECONDS=10

# --------------------------------------------------------------- daily cap
# Per student, per day, Asia/Dhaka. Counts requests, not model calls.
NEXTED_AI_DAILY_LIMIT=30
# The limit above only applies when this is true. Off = unlimited searches.
AI_LIMIT_ENABLED=false

# ----------------------------------------------------------------- storage
DATA_DIR=data
SEED_DIR=examples/seed

# THE ONE FILE THAT HAS TO COME FROM NEXTED.
# Point this at your real 47-rule partner list. Until you do, the sample is
# used and restriction checking is effectively off.
RESTRICTIONS_FILE=examples/restrictions.sample.json

# ---------------------------------------------------------------- tracing
# Off by default, and worth keeping off in production: a trace of every run
# is a second copy of your students' data living outside your database.
# Turn it on while debugging, then turn it back off.
# Key from smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexted-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------- knowledge base
# PostgreSQL + pgvector. Leave blank to run on the JSON files in data/.
#
# It shares the IELTS app's database: RUN_AI.bat copies DATABASE_URL from
# ..\server\.env, so there is nothing to fill in here when you start it
# that way (a value here is used only if you start it some other way).
# A Prisma-style "?schema=public" on the end is fine - it is ignored.
#
# Its tables go in their own schema (KB_SCHEMA, default nexted_ai), never in
# Prisma's "public", so the two never mix and Prisma migrations ignore them.
#
# Vectors need the pgvector add-on in PostgreSQL. Without it the knowledge
# base reports an error and the service carries on with the JSON files -
# or set EMBEDDINGS_PROVIDER=none to use the database with keywords only.
DATABASE_URL=
KB_SCHEMA=nexted_ai

# Text -> vector. Groq has no embeddings API, so:
#   fastembed  local, free, no key (BAAI/bge-small-en-v1.5, 384 dims).
#              First start downloads the model once (~130 MB).
#   gemini     Google's text-embedding-004 (768 dims), uses GEMINI_API_KEY
#   none       keywords only
# Changing it later is safe: vectors are rebuilt automatically.
EMBEDDINGS_PROVIDER=fastembed
EMBEDDING_MODEL=
EMBEDDING_DIM=
# How close in meaning (0-1) a stored row must be to count as a match.
# Below 4 close rows the finders go and research the web.
RAG_MIN_SIMILARITY=0.6
# Guides/FAQs the counsellor answers from (.md, .txt, .json Q&A).
KNOWLEDGE_DIR=knowledge
