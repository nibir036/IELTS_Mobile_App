    {
      "id": "ch3-linking-guide",
      "type": "linking_guide",
      "title": "Part A2: The Linking Word Upgrade Guide",
      "introduction": "Cohesion is scored directly, in the Coherence and Cohesion criterion in Writing and inside Fluency and Coherence in Speaking. Most candidates connect ideas with and, but, so, because, and also. These are not wrong, but a whole script built on them signals Band 6. The fix is a controlled set of higher-level devices, used accurately and not stacked one on top of another.",
      "categories": [
        {
          "category": "Addition",
          "basic": [
            "also",
            "and"
          ],
          "upgrades": [
            "furthermore",
            "moreover",
            "in addition",
            "additionally",
            "what is more"
          ],
          "example": "Renewable energy is clean. Furthermore, it is becoming cheaper each year."
        },
        {
          "category": "Contrast",
          "basic": [
            "but"
          ],
          "upgrades": [
            "however",
            "nevertheless",
            "in contrast",
            "conversely",
            "on the contrary"
          ],
          "example": "The scheme was expensive. Nevertheless, it delivered clear benefits."
        },
        {
          "category": "Concession",
          "description": "admitting a point, then countering it",
          "basic": [
            "but",
            "though"
          ],
          "upgrades": [
            "notwithstanding",
            "despite this",
            "even so",
            "admittedly",
            "granted that"
          ],
          "example": "Notwithstanding the cost, the investment proved worthwhile."
        },
        {
          "category": "Cause and reason",
          "basic": [
            "because"
          ],
          "upgrades": [
            "owing to",
            "due to",
            "on account of",
            "as a result of",
            "given that",
            "since"
          ],
          "example": "Owing to a shortage of teachers, class sizes have grown."
        },
        {
          "category": "Effect and result",
          "basic": [
            "so"
          ],
          "upgrades": [
            "consequently",
            "therefore",
            "thus",
            "hence",
            "as a result",
            "accordingly"
          ],
          "example": "Demand fell sharply; consequently, prices dropped."
        },
        {
          "category": "Comparison and alternative",
          "basic": [
            "on the other hand"
          ],
          "upgrades": [
            "conversely",
            "by contrast",
            "alternatively",
            "whereas"
          ],
          "example": "Some favour strict rules; conversely, others prefer flexibility."
        },
        {
          "category": "Example and illustration",
          "basic": [
            "like",
            "for example"
          ],
          "upgrades": [
            "for instance",
            "to illustrate",
            "namely",
            "such as"
          ],
          "example": "Several cities, such as Dhaka and Chittagong, are expanding rapidly."
        },
        {
          "category": "Conclusion",
          "basic": [
            "in the end"
          ],
          "upgrades": [
            "in conclusion",
            "to sum up",
            "overall",
            "on balance",
            "ultimately"
          ],
          "example": "On balance, the advantages outweigh the drawbacks."
        }
      ],
      "traps": [
        {
          "id": "trap-1",
          "title": "“due to” and “owing to” take a noun, not a clause.",
          "explanation": "These devices are followed by a noun or noun phrase. If you want a full clause with a subject and verb, use because.",
          "wrong": "Due to the government invested more, education improved.",
          "right": [
            "Owing to greater investment, education improved.",
            "Education improved because the government invested more."
          ]
        },
        {
          "id": "trap-2",
          "title": "“however” needs the right punctuation.",
          "explanation": "When however joins two complete sentences, it takes a full stop or semicolon before it and a comma after it. A comma alone on both sides creates a comma splice, which is penalised.",
          "wrong": "The plan was costly, however, it worked.",
          "right": [
            "The plan was costly. However, it worked.",
            "The plan was costly; however, it worked."
          ]
        },
        {
          "id": "trap-3",
          "title": "Do not overload.",
          "explanation": "One cohesive device per idea is enough. Beginning three sentences in a row with Moreover, Furthermore, In addition is a mechanical overuse that examiners explicitly penalise. Vary the devices, and let some sentences connect through meaning alone. Range means variety, not density."
        }
      ]
