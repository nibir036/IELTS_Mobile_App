{
  "schema_version": "2.0",
  "chapter": {
    "number": 3,
    "slug": "complete-verb-conjugations-and-formal-transitions",
    "title": "Complete Verb Conjugations and Formal Transitions",
    "language": "en-bn",
    "description": "Two kinds of error quietly cap otherwise strong scripts: getting a verb form wrong, and joining ideas with the same three schoolbook connectors. This chapter fixes both. The first half is a reference grid of 100 high-impact IELTS verbs with every form you will ever need to write them accurately, plus the noun and adjective in the same family so you can paraphrase by changing word class. The second half upgrades your linking words from the also / but / so level to the cohesive devices examiners associate with Band 7 and above, with the usage rules that stop those devices from backfiring.",
    "learning_objectives": [
      "Use the correct V1, V2, V3 and V4 forms of 100 high-impact IELTS verbs.",
      "Move across verb, noun and adjective word-family forms to paraphrase accurately.",
      "Use common verb-preposition collocations correctly.",
      "Upgrade basic linking words to higher-level cohesive devices.",
      "Use cohesive devices accurately without punctuation errors or mechanical overuse."
    ]
  },
  "blocks": [
    {
      "id": "ch3-verb-grid",
      "type": "verb_matrix",
      "title": "Part A1: The 100 High-Impact IELTS Verbs",
      "instructions": "Read the columns as a word family. The real power of this table is not memorising past tenses; it is being able to move across a row. If increase (verb) is overused, slide to an increase (noun) or increasing (adjective) and rebuild the sentence. That flexibility is exactly what Lexical Resource rewards.",
      "how_to_read": {
        "V1": "base form",
        "V2": "past simple",
        "V3": "past participle",
        "V4": "continuous (-ing) form",
        "noun": "most useful noun family member",
        "adjective": "most useful adjective family member",
        "preposition": "preposition that most commonly follows the verb or its noun",
        "-": "there is no common single-word form in that class, or no fixed preposition"
      },
      "spelling_note": "Spelling follows British conventions (analyse, emphasise, utilise), which IELTS accepts and expects.",
