# Copy to .env.local (development) or set in Coolify (production).
# All of these stay on the server: nothing here is sent to the browser.

# The IELTS AI API server (../server). Locally: http://localhost:4000
API_BASE_URL=https://mobile-api.nexted.app

# Same shared key the app sends (X-App-Key), if the server uses one.
APP_KEY=

# Public address of this website (links, sitemap, cookies over https).
SITE_URL=https://nexted.app
